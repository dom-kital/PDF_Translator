<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDFTranslator.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PDFTranslator.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PDFTranslator GUI - 基于 Ollama 的 PDF 翻译工具"
        MinWidth="700" MinHeight="500"
        Width="800" Height="600"
        Icon="/Assets/avalonia-logo.ico">

    <!-- 
        外层 ScrollViewer 提供垂直滚动条，当窗口高度不足时允许滚动查看所有内容
        VerticalScrollBarVisibility="Auto" 表示仅在需要时显示滚动条
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 
            内部 Grid 采用行定义布局，共12行（0-11）：
            0: Ollama 服务配置
            1: 文件选择（输入）
            2: 文件选择（输出）
            3: 翻译选项
            4: 字体设置
            5: 页面范围
            6: 开始按钮
            7: 进度条
            8: 内存监控（新增）
            9: 日志标题
            10: 日志文本框（占据剩余空间）
            11: 底部留白
        -->
        <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
            
            <!-- 定义全局样式，用于分组边框和标题，保持界面统一 -->
            <Grid.Styles>
                <!-- 分组边框样式：灰色边框、圆角、内边距、底部边距 -->
                <Style Selector="Border.groupBox">
                    <Setter Property="BorderBrush" Value="#DDD"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                </Style>
                <!-- 分组标题样式：粗体、稍大字体、底部边距 -->
                <Style Selector="TextBlock.groupTitle">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                </Style>
                <!-- 内存警告样式：红色背景 -->
                <Style Selector="Border.memoryWarning">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="BorderBrush" Value="#F44336"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
                <!-- 内存信息样式：灰色背景 -->
                <Style Selector="Border.memoryInfo">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </Grid.Styles>

            <!-- ===== 第0行：Ollama 服务配置 ===== -->
            <Border Grid.Row="0" Classes="groupBox">
                <StackPanel>
                    <!-- 分组标题 -->
                    <TextBlock Text="⚙️ Ollama 服务" Classes="groupTitle"/>
                    
                    <!-- 第一行：URL输入框 + 状态文本 + 测试按钮 + 保存按钮 -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,5">
                        <TextBox Text="{Binding OllamaUrl}" 
                                 Watermark="http://localhost:11434" 
                                 Grid.Column="0" 
                                 Margin="0,0,5,0"
                                 ToolTip.Tip="Ollama 服务的地址，例如 http://localhost:11434" />
                        <TextBlock Text="{Binding OllamaStatusMessage}" 
                                   Grid.Column="1" 
                                   VerticalAlignment="Center" 
                                   Margin="5,0" 
                                   FontWeight="Bold" />
                        <Button Content="测试连接" 
                                Command="{Binding TestOllamaConnectionCommand}" 
                                Grid.Column="2" 
                                Margin="5,0" 
                                Padding="10,2"
                                ToolTip.Tip="测试与 Ollama 服务的连接" />
                        <Button Content="保存" 
                                Command="{Binding SaveOllamaConfigCommand}" 
                                Grid.Column="3" 
                                Padding="10,2"
                                ToolTip.Tip="保存当前 Ollama 配置到日志" />
                    </Grid>

                    <!-- 第二行：模型下拉菜单 + 超时时间 + 刷新模型按钮 -->
                    <Grid ColumnDefinitions="2*,*,Auto">
                        <!-- 模型下拉菜单区域 -->
                        <Grid Grid.Column="0" Margin="0,0,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,5,0" 
                                       Grid.Column="0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      IsEnabled="{Binding IsOllamaConnected}"
                                      ToolTip.Tip="选择要使用的 Ollama 模型" />
                        </Grid>

                        <!-- 超时时间输入区域 -->
                        <Grid ColumnDefinitions="Auto,*" Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="超时:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,5,0" />
                            <TextBox Text="{Binding TimeoutSeconds}" 
                                     Watermark="秒" 
                                     Grid.Column="1"
                                     ToolTip.Tip="API 请求超时时间（秒）" />
                        </Grid>

                        <!-- 刷新模型按钮 -->
                        <Button Grid.Column="2" 
                                Padding="10,2"
                                Command="{Binding RefreshModelsCommand}"
                                IsEnabled="{Binding IsOllamaConnected}"
                                ToolTip.Tip="{Binding ModelListStatus}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="🔄" />
                                <TextBlock Text="刷新模型" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 连接状态指示器：根据 IsOllamaConnected 切换显示 -->
                    <Border Background="#4CAF50" 
                            CornerRadius="3" 
                            Padding="5" 
                            Margin="0,5,0,0"
                            IsVisible="{Binding IsOllamaConnected}">
                        <TextBlock Text="✓ Ollama 已连接" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#FF9800" 
                            CornerRadius="3" 
                            Padding="5" 
                            Margin="0,5,0,0"
                            IsVisible="{Binding !IsOllamaConnected}">
                        <TextBlock Text="✗ Ollama 未连接" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 第1行：输入文件选择 ===== -->
            <Border Grid.Row="1" Classes="groupBox">
                <StackPanel>
                    <TextBlock Text="📁 文件" Classes="groupTitle"/>
                    <!-- 输入文件选择行 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                        <TextBox Text="{Binding InputPath}" 
                                 Watermark="输入 PDF 文件" 
                                 IsReadOnly="True"
                                 ToolTip.Tip="要翻译的源 PDF 文件路径，可通过浏览按钮选择"/>
                        <Button Grid.Column="1" 
                                Content="浏览..." 
                                Command="{Binding SelectInputCommand}" 
                                Margin="5,0,0,0" 
                                Padding="10,2"
                                ToolTip.Tip="打开文件选择对话框，选择要翻译的 PDF 文件"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 第2行：输出文件选择（支持自动命名）===== -->
            <Border Grid.Row="2" Classes="groupBox">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding OutputPath}" 
                                 Watermark="输出 PDF 文件路径（可手动修改）" 
                                 IsReadOnly="False"
                                 ToolTip.Tip="程序会根据输入文件名和翻译模式自动建议（_translated 或 _bilingual），您也可以手动输入或通过浏览按钮修改"/>
                        <Button Grid.Column="1" 
                                Content="浏览..." 
                                Command="{Binding SelectOutputCommand}" 
                                Margin="5,0,0,0" 
                                Padding="10,2"
                                ToolTip.Tip="打开保存文件对话框，选择输出文件位置"/>
                    </Grid>
                    <!-- 添加一行小提示，让用户更清楚自动命名规则 -->
                    <TextBlock Text="提示：自动添加 _translated（仅译文）或 _bilingual（双语）后缀" 
                               FontSize="10" 
                               Foreground="Gray" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 第3行：翻译选项 ===== -->
            <Border Grid.Row="3" Classes="groupBox">
                <StackPanel>
                    <TextBlock Text="🌐 翻译选项" Classes="groupTitle"/>
                    
                    <!-- 模式选择：仅译文/双语对照 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="20">
                        <RadioButton Content="📄 仅译文模式" 
                                     IsChecked="{Binding !IsBilingual}"
                                     ToolTip.Tip="用译文替换原文，适合背景为白色的文档"/>
                        <RadioButton Content="📑 双语对照模式" 
                                     IsChecked="{Binding IsBilingual}"
                                     ToolTip.Tip="保留原文，在原文下方添加蓝色半透明译文，便于对比学习"/>
                    </StackPanel>

                    <!-- 语言选择：源语言和目标语言，使用紧凑布局 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5" Margin="0,0,0,10">
                        <ComboBox ItemsSource="{Binding SourceLanguages}"
                                  SelectedItem="{Binding SourceLanguage}"
                                  MinWidth="60"
                                  ToolTip.Tip="源语言代码（如 en, zh, ja）"/>
                        <TextBlock Text=" → " VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding TargetLanguage}"
                                  MinWidth="60"
                                  ToolTip.Tip="目标语言代码（如 zh, en, fr）"/>
                    </StackPanel>

                    <!-- 图片翻译（预留功能，暂时禁用） -->
                    <CheckBox Content="🖼️ 翻译图片中的文字（预留）" 
                              IsChecked="{Binding TranslateImages}"
                              IsEnabled="False"
                              ToolTip.Tip="此功能正在开发中，敬请期待"/>
                </StackPanel>
            </Border>

            <!-- ===== 第4行：字体设置 ===== -->
            <Border Grid.Row="4" Classes="groupBox">
                <StackPanel>
                    <TextBlock Text="🔤 字体" Classes="groupTitle"/>
                    
                    <!-- 字体名称输入 -->
                    <Grid Margin="0,0,0,5">
                        <TextBox Text="{Binding FontName}" 
                                 Watermark="字体名称（可选，如 SimSun）"
                                 ToolTip.Tip="系统已安装的字体名称，留空则自动检测"/>
                    </Grid>
                    
                    <!-- 字体文件路径选择 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding FontPath}" 
                                 Watermark="字体文件路径（可选）"
                                 ToolTip.Tip="直接指定字体文件路径（支持 .ttf/.ttc/.otf）"/>
                        <Button Grid.Column="1" 
                                Content="浏览..." 
                                Command="{Binding SelectFontCommand}" 
                                Margin="5,0,0,0" 
                                Padding="10,2"
                                ToolTip.Tip="选择字体文件"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 第5行：页面范围选择 ===== -->
            <Border Grid.Row="5" Classes="groupBox">
                <StackPanel>
                    <TextBlock Text="📄 页面范围" Classes="groupTitle"/>
                    
                    <!-- 模式选择：全部/范围/单页 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="20">
                        <RadioButton Content="全部页面" 
                                     IsChecked="{Binding IsAllPages}"
                                     ToolTip.Tip="翻译 PDF 中的所有页面"/>
                        <RadioButton Content="页码范围" 
                                     IsChecked="{Binding IsRangePages}"
                                     ToolTip.Tip="指定页码范围，如 1-5,7,9-11"/>
                        <RadioButton Content="单页" 
                                     IsChecked="{Binding IsSinglePage}"
                                     ToolTip.Tip="翻译单个指定页面"/>
                    </StackPanel>

                    <!-- 页码范围输入（当选择 Range 时显示）-->
                    <Grid IsVisible="{Binding ShowRangeInput}"
                          Margin="0,0,0,5">
                        <TextBox Text="{Binding PageRange}" 
                                 Watermark="例如: 1-5,7,9-11"
                                 ToolTip.Tip="输入页码范围，用逗号分隔，支持连字符表示范围"/>
                    </Grid>

                    <!-- 单页输入（当选择 Single 时显示）-->
                    <Grid IsVisible="{Binding ShowSingleInput}"
                          ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                        <TextBlock Text="页码:" VerticalAlignment="Center" Margin="0,0,5,0" Grid.Column="0"/>
                        <TextBox Text="{Binding SinglePage}" 
                                 Watermark="输入页码"
                                 Grid.Column="1"
                                 ToolTip.Tip="输入要翻译的单个页码"/>
                    </Grid>

                    <!-- 显示总页数信息 -->
                    <TextBlock Text="{Binding TotalPages, StringFormat='总页数: {0}'}" 
                               FontSize="11" 
                               Foreground="Gray"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 第6行：开始翻译按钮 ===== -->
            <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,10">
                <Button Content="▶ 开始翻译" 
                        Command="{Binding StartCommand}" 
                        IsEnabled="{Binding !IsBusy}"
                        Padding="30,8" 
                        FontWeight="Bold" 
                        FontSize="14"
                        ToolTip.Tip="开始翻译 PDF 文件，需要先选择输入和输出文件"/>
            </StackPanel>

            <!-- ===== 第7行：进度条（仅在翻译时显示）===== -->
            <StackPanel Grid.Row="7" 
                        IsVisible="{Binding ShowProgress}" 
                        Margin="0,5" 
                        Spacing="5">
                <TextBlock Text="{Binding ProgressMessage}" 
                           FontStyle="Italic"/>
                <ProgressBar Value="{Binding ProgressValue}" 
                             Maximum="{Binding ProgressMax}" 
                             Height="20" 
                             Foreground="#2196F3"/>
            </StackPanel>

            <!-- ===== 第8行：内存监控区域（新增）===== -->
            <StackPanel Grid.Row="8" Margin="0,5" Spacing="5">
                <!-- 内存警告信息（当内存过高时显示） -->
                <Border IsVisible="{Binding ShowMemoryWarning}" Classes="memoryWarning">
                    <TextBlock Text="{Binding MemoryWarningMessage}" 
                               Foreground="#D32F2F"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </Border>
                
                <!-- 内存使用信息（始终显示） -->
                <Border Classes="memoryInfo">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="💾" FontSize="14"/>
                        <TextBlock Text="{Binding MemoryUsage}" 
                                   FontSize="11"
                                   Foreground="#616161"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 第9行：日志标题 ===== -->
            <TextBlock Grid.Row="9" 
                       Text="📋 操作日志" 
                       FontWeight="SemiBold" 
                       Margin="0,10,0,5"/>

            <!-- ===== 第10行：日志文本框（占据剩余空间，自动滚动）===== -->
            <TextBox x:Name="LogTextBox"
                     Grid.Row="10"
                     Text="{Binding Log}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Courier New, monospace"
                     FontSize="11"
                     Background="#F5F5F5"
                     ToolTip.Tip="操作日志，显示翻译过程中的详细信息，会自动滚动到底部"/>

            <!-- ===== 第11行：底部留白 ===== -->
            <Grid Grid.Row="11"/>
        </Grid>
    </ScrollViewer>
</Window>