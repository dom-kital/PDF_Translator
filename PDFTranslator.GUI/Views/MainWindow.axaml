<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDFTranslator.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PDFTranslator.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PDFTranslator GUI - 基于 Ollama 的 PDF 翻译工具"
        MinWidth="700" MinHeight="500"
        Width="800" Height="600"
        Icon="/Assets/avalonia-logo.ico">

    <!-- 主网格布局：共11行 -->
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

        <!-- 第0行：Ollama 配置区域（可折叠） -->
        <Expander Header="⚙️ Ollama 配置" 
                  Grid.Row="0" 
                  Margin="0,0,0,5" 
                  IsExpanded="True"
                  Background="#F5F5F5"
                  CornerRadius="3"
                  Padding="5">
            
            <StackPanel Margin="5" Spacing="8">
                
                <!-- 第一行：URL输入框 + 状态显示 + 测试按钮 + 保存按钮 -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Text="{Binding OllamaUrl}" 
                             Watermark="http://localhost:11434" 
                             Grid.Column="0" 
                             Margin="0,0,5,0"
                             ToolTip.Tip="Ollama 服务的地址" />
                    
                    <TextBlock Text="{Binding OllamaStatusMessage}" 
                               Grid.Column="1" 
                               VerticalAlignment="Center" 
                               Margin="5,0"
                               FontWeight="Bold" />
                    
                    <Button Content="测试连接" 
                            Command="{Binding TestOllamaConnectionCommand}" 
                            Grid.Column="2" 
                            Margin="5,0" 
                            Padding="10,2"
                            ToolTip.Tip="测试与 Ollama 服务的连接" />
                    
                    <Button Content="保存" 
                            Command="{Binding SaveOllamaConfigCommand}" 
                            Grid.Column="3" 
                            Padding="10,2"
                            ToolTip.Tip="保存当前 Ollama 配置" />
                </Grid>

                <!-- 第二行：模型下拉菜单 + 超时时间 + 刷新按钮 -->
                <Grid ColumnDefinitions="2*,*,Auto">
                    
                    <!-- 模型下拉菜单 -->
                    <Grid Grid.Column="0" Margin="0,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="模型:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,5,0" 
                                   Grid.Column="0"/>
                        
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  IsEnabled="{Binding IsOllamaConnected}"
                                  ToolTip.Tip="选择要使用的 Ollama 模型">
                            <ComboBox.DataTemplates>
                                <DataTemplate DataType="vm:OllamaModelInfo">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Size, StringFormat='({0:F1} MB)'}" 
                                                   Foreground="Gray" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.DataTemplates>
                        </ComboBox>
                    </Grid>
                    
                    <!-- 超时时间输入框 -->
                    <Grid ColumnDefinitions="Auto,*" Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="超时:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,5,0" />
                        <TextBox Text="{Binding TimeoutSeconds}" 
                                 Watermark="秒" 
                                 Grid.Column="1"
                                 ToolTip.Tip="API 请求超时时间（秒）" />
                    </Grid>
                    
                    <!-- 刷新模型按钮 - 简化版，移除动画 -->
                    <Button Grid.Column="2" 
                            Padding="10,2"
                            Command="{Binding RefreshModelsCommand}"
                            IsEnabled="{Binding IsOllamaConnected}"
                            ToolTip.Tip="{Binding ModelListStatus}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="🔄" />
                            <TextBlock Text="刷新模型" />
                            <!-- 使用简单的文本显示加载状态，替代动画 -->
                            <TextBlock Text="..." 
                                       IsVisible="{Binding IsRefreshingModels}"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 模型列表状态信息 -->
                <TextBlock Text="{Binding ModelListStatus}" 
                           FontSize="11" 
                           Foreground="Gray"
                           IsVisible="{Binding !IsRefreshingModels}" />

                <!-- 连接状态指示器 -->
                <Border Background="#4CAF50" 
                        CornerRadius="3" 
                        Padding="5" 
                        IsVisible="{Binding IsOllamaConnected}">
                    <TextBlock Text="✓ Ollama 已连接" 
                               Foreground="White" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Border>
                
                <Border Background="#FF9800" 
                        CornerRadius="3" 
                        Padding="5" 
                        IsVisible="{Binding !IsOllamaConnected}">
                    <TextBlock Text="✗ Ollama 未连接" 
                               Foreground="White" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Expander>

        <!-- 第1行：输入文件选择 -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="1" Margin="0,5">
            <TextBox Text="{Binding InputPath}" 
                     Watermark="选择输入 PDF 文件" 
                     IsReadOnly="True"
                     ToolTip.Tip="要翻译的源 PDF 文件路径" />
            <Button Grid.Column="1" 
                    Content="浏览..." 
                    Command="{Binding SelectInputCommand}" 
                    Margin="5,0,0,0" 
                    Padding="10,2"
                    ToolTip.Tip="打开文件选择对话框" />
        </Grid>

        <!-- 第2行：输出文件选择 -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="2" Margin="0,5">
            <TextBox Text="{Binding OutputPath}" 
                     Watermark="选择输出 PDF 文件路径" 
                     IsReadOnly="True"
                     ToolTip.Tip="翻译完成后保存的 PDF 文件路径" />
            <Button Grid.Column="1" 
                    Content="浏览..." 
                    Command="{Binding SelectOutputCommand}" 
                    Margin="5,0,0,0" 
                    Padding="10,2"
                    ToolTip.Tip="打开保存文件对话框" />
        </Grid>

        <!-- 第3行：翻译模式选择 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5" Spacing="20">
            <RadioButton Content="📄 仅译文模式" 
                         IsChecked="{Binding !IsBilingual}"
                         ToolTip.Tip="用译文替换原文，适合背景为白色的文档" />
            <RadioButton Content="🌐 双语对照模式" 
                         IsChecked="{Binding IsBilingual}"
                         ToolTip.Tip="保留原文，在原文下方添加蓝色半透明译文" />
        </StackPanel>

        <!-- 第4行：图片翻译选项（预留） -->
        <CheckBox Grid.Row="4" 
                  Content="🖼️ 翻译图片中的文字（预留功能）" 
                  IsChecked="{Binding TranslateImages}" 
                  Margin="0,5"
                  IsEnabled="False"
                  ToolTip.Tip="此功能正在开发中，敬请期待" />

        <!-- 第5行：字体名称输入 -->
        <Grid Grid.Row="5" Margin="0,5">
            <TextBox Text="{Binding FontName}" 
                     Watermark="字体名称（可选，如 SimSun）"
                     ToolTip.Tip="指定字体名称（系统需安装该字体）" />
        </Grid>

        <!-- 第6行：字体文件路径选择 -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="6" Margin="0,5">
            <TextBox Text="{Binding FontPath}" 
                     Watermark="字体文件路径（可选）"
                     ToolTip.Tip="直接指定字体文件路径" />
            <Button Grid.Column="1" 
                    Content="浏览..." 
                    Command="{Binding SelectFontCommand}" 
                    Margin="5,0,0,0" 
                    Padding="10,2"
                    ToolTip.Tip="选择字体文件（支持 .ttf、.ttc、.otf）" />
        </Grid>

        <!-- 第7行：开始翻译按钮 -->
        <Button Grid.Row="7" 
                Content="▶ 开始翻译" 
                Command="{Binding StartCommand}" 
                IsEnabled="{Binding !IsBusy}" 
                Margin="0,10" 
                HorizontalAlignment="Center" 
                Padding="25,8"
                FontWeight="Bold"
                ToolTip.Tip="开始翻译 PDF 文件" />

        <!-- 第8行：进度条区域 -->
        <StackPanel Grid.Row="8" 
                    Margin="0,5" 
                    IsVisible="{Binding ShowProgress}"
                    Spacing="5">
            <TextBlock Text="{Binding ProgressMessage}" 
                       Margin="0,0,0,5"
                       FontStyle="Italic" />
            <ProgressBar Value="{Binding ProgressValue}" 
                         Maximum="{Binding ProgressMax}" 
                         Height="20"
                         Foreground="#2196F3" />
        </StackPanel>

        <!-- 第9行：日志区域 -->
        <TextBox Grid.Row="9" 
                 Text="{Binding Log}" 
                 IsReadOnly="True" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,5" 
                 Height="150"
                 FontFamily="Consolas, Courier New, monospace"
                 FontSize="11"
                 Background="#F5F5F5"
                 ToolTip.Tip="操作日志，显示翻译过程中的详细信息" />

        <!-- 第10行：底部留白 -->
    </Grid>
</Window>