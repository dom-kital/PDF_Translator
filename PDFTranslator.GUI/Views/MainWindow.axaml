<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDFTranslator.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PDFTranslator.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PDFTranslator GUI"
        MinWidth="600" MinHeight="400"
        Width="800" Height="600"
        Icon="/Assets/avalonia-logo.ico">

    <!-- 使用 Grid 布局，行定义：输入行、输出行、模式选择、图片选项、按钮、日志区域 -->
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- 输入文件选择行 -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="0" Margin="0,5">
            <TextBox Text="{Binding InputPath}" Watermark="输入 PDF 文件路径" IsReadOnly="True" />
            <Button Grid.Column="1" Content="浏览..." Command="{Binding SelectInputCommand}" Margin="5,0,0,0" Padding="10,2" />
        </Grid>

        <!-- 输出文件选择行 -->
        <Grid ColumnDefinitions="*,Auto" Grid.Row="1" Margin="0,5">
            <TextBox Text="{Binding OutputPath}" Watermark="输出 PDF 文件路径" IsReadOnly="True" />
            <Button Grid.Column="1" Content="浏览..." Command="{Binding SelectOutputCommand}" Margin="5,0,0,0" Padding="10,2" />
        </Grid>

        <!-- 模式选择：两个 RadioButton 分别绑定 IsBilingual 和其相反值 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5" Spacing="20">
            <RadioButton Content="仅译文模式" IsChecked="{Binding !IsBilingual}" />
            <RadioButton Content="双语对照模式" IsChecked="{Binding IsBilingual}" />
        </StackPanel>

        <!-- 图片翻译选项（预留功能） -->
        <CheckBox Grid.Row="3" Content="翻译图片中的文字（预留功能，暂不可用）" 
                  IsChecked="{Binding TranslateImages}" Margin="0,5" />

        <!-- 开始按钮 -->
        <Button Grid.Row="4" Content="开始翻译" Command="{Binding StartCommand}" 
                IsEnabled="{Binding !IsBusy}" Margin="0,10" HorizontalAlignment="Center" Padding="20,5" />

        <!-- 日志区域：TextBox 支持自动换行和垂直滚动 -->
        <TextBox Grid.Row="5" Text="{Binding Log}" IsReadOnly="True" 
                 AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,5" />
    </Grid>
</Window>